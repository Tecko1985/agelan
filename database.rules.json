{
  "rules": {
    "turniere": {
      "_index": {
        ".read": true,
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || (!newData.exists() && (!root.child('turniere/' + $id).exists() || (root.child('turniere/' + $id + '/meta/hostId').val() === auth.uid || (root.child('turnierGeheim/' + $id + '/adminPinHash').exists() && root.child('turnierPinProbe/' + $id + '/' + auth.uid).val() === root.child('turnierGeheim/' + $id + '/adminPinHash').val())))))",
          ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 60"
        }
      },
      "$tid": {
        ".read": true,
        ".write": "auth != null && ((root.child('turniere/' + $tid + '/meta/hostId').val() === auth.uid || (root.child('turnierGeheim/' + $tid + '/adminPinHash').exists() && root.child('turnierPinProbe/' + $tid + '/' + auth.uid).val() === root.child('turnierGeheim/' + $tid + '/adminPinHash').val())) || (!data.exists() && newData.child('meta/hostId').val() === auth.uid))",

        "meta": {
          ".validate": "newData.hasChildren(['name', 'phase'])",
          "name":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "phase": {
            ".write": "auth != null && data.val() === 'ko' && newData.val() === 'beendet' && root.child('turniere/' + $tid + '/spieler/' + auth.uid).exists()",
            ".validate": "newData.isString()"
          },
          "siegerTeamId": { ".write": "auth != null && !data.exists() && newData.exists() && root.child('turniere/' + $tid + '/meta/phase').val() === 'ko' && root.child('turniere/' + $tid + '/spieler/' + auth.uid).exists()" },
          "bestOf": { ".validate": "newData.isNumber()" },

          "adminPin": { ".validate": false }
        },

        "spieler": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (root.child('turniere/' + $tid + '/meta/phase').val() === 'anmeldung' || (root.child('turniere/' + $tid + '/meta/phase').val() === 'teams' && data.exists() && newData.exists()))",
            ".validate": "newData.hasChildren(['name', 'rating'])",
            "name":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "rating": { ".validate": "newData.isNumber() && newData.val() >= 500 && newData.val() <= 3000" }
          }
        },

        "teams": {
          "$team": {
            "ratingSchnitt": {
              ".write": "auth != null && root.child('turniere/' + $tid + '/meta/phase').val() === 'teams' && root.child('turniere/' + $tid + '/teams/' + $team + '/mitglieder/' + auth.uid).exists()",
              ".validate": "newData.isNumber()"
            }
          }
        },

        "spiele": {
          "$sid": {
            ".write": "auth != null && ((!data.exists() && newData.child('phase').val() === 'ko' && root.child('turniere/' + $tid + '/meta/phase').val() === 'ko' && root.child('turniere/' + $tid + '/spieler/' + auth.uid).exists()) || (data.exists() && newData.exists() && data.child('status').val() !== 'bestaetigt' && ((data.child('teamA').exists() && root.child('turniere/' + $tid + '/teams/' + data.child('teamA').val() + '/mitglieder/' + auth.uid).exists()) || (data.child('teamB').exists() && root.child('turniere/' + $tid + '/teams/' + data.child('teamB').val() + '/mitglieder/' + auth.uid).exists())) && newData.child('teamA').val() === data.child('teamA').val() && newData.child('teamB').val() === data.child('teamB').val() && newData.child('phase').val() === data.child('phase').val() && newData.child('runde').val() === data.child('runde').val() && newData.child('position').val() === data.child('position').val() && newData.child('bracket').val() === data.child('bracket').val() && newData.child('gruppe').val() === data.child('gruppe').val() && newData.child('geplantAm').val() === data.child('geplantAm').val() && newData.child('dauerMin').val() === data.child('dauerMin').val() && newData.child('istFinale').val() === data.child('istFinale').val() && newData.child('platz3').val() === data.child('platz3').val() && newData.child('entscheidung').val() === data.child('entscheidung').val() && ((newData.child('status').val() === 'gemeldet' && newData.child('gemeldetVon').exists() && root.child('turniere/' + $tid + '/teams/' + newData.child('gemeldetVon').val() + '/mitglieder/' + auth.uid).exists()) || (newData.child('status').val() === 'offen' && data.child('status').val() === 'gemeldet' && !newData.child('gemeldetVon').exists() && !newData.child('saetzeA').exists() && !newData.child('saetzeB').exists()) || (newData.child('status').val() === 'bestaetigt' && data.child('status').val() === 'gemeldet' && newData.child('saetzeA').val() === data.child('saetzeA').val() && newData.child('saetzeB').val() === data.child('saetzeB').val() && newData.child('gemeldetVon').val() === data.child('gemeldetVon').val() && !(data.child('gemeldetVon').exists() && root.child('turniere/' + $tid + '/teams/' + data.child('gemeldetVon').val() + '/mitglieder/' + auth.uid).exists())))))",
            "saetzeA": { ".validate": "newData.isNumber() || newData.val() == null" },
            "saetzeB": { ".validate": "newData.isNumber() || newData.val() == null" },
            "status":  { ".validate": "newData.isString()" },
            "geplantAm": { ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$/))" },
            "dauerMin":  { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 5 && newData.val() <= 600)" }
          }
        },

        "$sonst": { ".validate": "$sonst === 'gruppen' || $sonst === 'spieltagDaten'" }
      }
    },

    "turnierGeheim": {
      "$tid": {
        "adminPinHash": {
          ".write": "auth != null && ((!data.exists() && (root.child('turniere/' + $tid + '/meta/hostId').val() === auth.uid || root.child('turniere/' + $tid + '/meta/adminPin').exists())) || (data.exists() && data.val() === root.child('turnierPinProbe').child($tid).child(auth.uid).val()))",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
        },
        "$sonst": { ".validate": false }
      }
    },

    "turnierPinProbe": {
      "$tid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('turnierPinTakt').child($tid).child(auth.uid).val() > now - 5000)",
          ".validate": "newData.isString() && newData.val() === root.child('turnierGeheim').child($tid).child('adminPinHash').val()"
        }
      }
    },

    "streamplanGeheim": {
      "$pid": {
        "adminPinHash": {
          ".write": "auth != null && ((!data.exists() && (root.child('streamplan/' + $pid + '/meta/hostId').val() === auth.uid || root.child('streamplan/' + $pid + '/meta/adminPin').exists())) || (data.exists() && data.val() === root.child('streamplanPinProbe').child($pid).child(auth.uid).val()))",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
        },
        "$sonst": { ".validate": false }
      }
    },

    "streamplanPinProbe": {
      "$pid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('streamplanPinTakt').child($pid).child(auth.uid).val() > now - 5000)",
          ".validate": "newData.isString() && newData.val() === root.child('streamplanGeheim').child($pid).child('adminPinHash').val()"
        }
      }
    },

    "turnierPinTakt": {
      "$tid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || now > data.val() + 1000)",
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000"
        }
      }
    },

    "streamplanPinTakt": {
      "$pid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || now > data.val() + 1000)",
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000"
        }
      }
    },

    "fruehstueckPinTakt": {
      "$pid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || now > data.val() + 1000)",
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000"
        }
      }
    },

    "essenPinTakt": {
      "$pid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || now > data.val() + 1000)",
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000"
        }
      }
    },

    "fruehstueckGeheim": {
      "$pid": {
        "adminPinHash": {
          ".write": "auth != null && ((!data.exists() && $pid.beginsWith('fruehstueck-') && (root.child('fruehstueck/' + $pid.replace('fruehstueck-', '') + '/meta/hostId').val() === auth.uid || root.child('fruehstueck/' + $pid.replace('fruehstueck-', '') + '/meta/adminPin').exists())) || (data.exists() && data.val() === root.child('fruehstueckPinProbe').child($pid).child(auth.uid).val()))",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
        },
        "$sonst": { ".validate": false }
      }
    },

    "fruehstueckPinProbe": {
      "$pid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('fruehstueckPinTakt').child($pid).child(auth.uid).val() > now - 5000)",
          ".validate": "newData.isString() && newData.val() === root.child('fruehstueckGeheim').child($pid).child('adminPinHash').val()"
        }
      }
    },

    "essenGeheim": {
      "$pid": {
        "adminPinHash": {
          ".write": "auth != null && ((!data.exists() && $pid.beginsWith('essen-') && (root.child('essen/' + $pid.replace('essen-', '') + '/meta/hostId').val() === auth.uid || root.child('essen/' + $pid.replace('essen-', '') + '/meta/adminPin').exists())) || (data.exists() && data.val() === root.child('essenPinProbe').child($pid).child(auth.uid).val()))",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
        },
        "$sonst": { ".validate": false }
      }
    },

    "essenPinProbe": {
      "$pid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('essenPinTakt').child($pid).child(auth.uid).val() > now - 5000)",
          ".validate": "newData.isString() && newData.val() === root.child('essenGeheim').child($pid).child('adminPinHash').val()"
        }
      }
    },

    "streamplan": {
      "$pid": {
        ".read": true,
        ".write": "auth != null && ((root.child('streamplan/' + $pid + '/meta/hostId').val() === auth.uid || (root.child('streamplanGeheim/' + $pid + '/adminPinHash').exists() && root.child('streamplanPinProbe/' + $pid + '/' + auth.uid).val() === root.child('streamplanGeheim/' + $pid + '/adminPinHash').val())) || (!data.child('meta').exists() && newData.child('meta/hostId').val() === auth.uid))",

        "meta": {
          ".validate": "newData.hasChildren(['titel', 'startDatum', 'anzahlTage'])",
          "titel":       { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "startDatum":  { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "anzahlTage":  { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7" },
          "standardVon": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440" },
          "standardBis": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1800" },

          "adminPin": { ".validate": false }
        },

        "tage": {
          "$datum": {
            "von": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440" },
            "bis": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1800" }
          }
        },

        "programm": {
          "$id": {
            ".validate": "newData.hasChildren(['datum', 'von', 'bis', 'titel'])",
            "datum": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "von":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1800" },
            "bis":   { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1800" },
            "titel": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "notiz": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "streamerNoetig": { ".validate": "newData.isBoolean()" }
          }
        },

        "slots": {
          "$sid": {
            ".write": "auth != null && ((newData.exists() && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)) || (!newData.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['datum', 'von', 'bis', 'streamer'])",
            "datum":    { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "von":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1800" },
            "bis":      { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1800" },
            "streamer": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "titel":    { ".validate": "newData.isString() && newData.val().length <= 60" },
            "notiz":    { ".validate": "newData.isString() && newData.val().length <= 200" },
            "uid":      { ".validate": "newData.isString()" }
          }
        }
      }
    },

    "fruehstueck": {
      "$pid": {
        ".read": true,
        ".write": "auth != null && ((root.child('fruehstueck/' + $pid + '/meta/hostId').val() === auth.uid || (root.child('fruehstueckGeheim/' + 'fruehstueck-' + $pid + '/adminPinHash').exists() && root.child('fruehstueckPinProbe/' + 'fruehstueck-' + $pid + '/' + auth.uid).val() === root.child('fruehstueckGeheim/' + 'fruehstueck-' + $pid + '/adminPinHash').val())) || (!data.child('meta').exists() && newData.child('meta/hostId').val() === auth.uid))",

        "meta": {
          ".validate": "newData.hasChildren(['titel', 'startDatum', 'anzahlTage'])",
          "titel":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "startDatum": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "anzahlTage": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7" },
          "schlussUhr":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440" },
          "annahmeOffen": { ".validate": "newData.isBoolean()" },

          "adminPin": { ".validate": false }
        },

        "pakete": {
          "$pak": {
            ".validate": "newData.hasChildren(['name', 'preisCent'])",
            "name":         { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "beschreibung": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "preisCent":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
            "sort":         { ".validate": "newData.isNumber()" }
          }
        },

        "bestellungen": {
          "$datum": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid && ((!newData.exists() && data.child('bezahlt').val() !== true) || (newData.exists() && (newData.child('bezahlt').val() === data.child('bezahlt').val() || (!data.child('bezahlt').exists() && newData.child('bezahlt').val() !== true)) && (newData.child('abgeholt').val() === data.child('abgeholt').val() || (!data.child('abgeholt').exists() && newData.child('abgeholt').val() !== true))))",
              ".validate": "newData.hasChildren(['name', 'positionen'])",
              "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
              "notiz":    { ".validate": "newData.isString() && newData.val().length <= 200" },
              "abgeholt": { ".validate": "newData.isBoolean()" },
              "positionen": {
                "$pak": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9" }
              }
            }
          }
        }
      }
    },

    "essen": {
      "$pid": {
        ".read": "auth != null",
        ".write": "auth != null && ((root.child('essen/' + $pid + '/meta/hostId').val() === auth.uid || (root.child('essenGeheim/' + 'essen-' + $pid + '/adminPinHash').exists() && root.child('essenPinProbe/' + 'essen-' + $pid + '/' + auth.uid).val() === root.child('essenGeheim/' + 'essen-' + $pid + '/adminPinHash').val())) || (!data.child('meta').exists() && newData.child('meta/hostId').val() === auth.uid))",

        "meta": {
          ".validate": "newData.hasChildren(['titel'])",
          "titel":            { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "lieferantName":    { ".validate": "newData.isString() && newData.val().length <= 80" },
          "lieferantEmail":   { ".validate": false },
          "bestellerName":    { ".validate": "newData.isString() && newData.val().length <= 60" },
          "bestellerTelefon": { ".validate": false },
          "hinweis":          { ".validate": "newData.isString() && newData.val().length <= 400" },
          "annahmeOffen":     { ".validate": "newData.isBoolean()" },
          "annahmeVon":       { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() < 1440" },
          "annahmeBis":       { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() < 1440" },
          "rundeZaehler":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "rundeTag":         { ".validate": "newData.isString() && newData.val().length <= 60" },

          "adminPin": { ".validate": false }
        },

        "runden": {
          "$rid": {
            ".validate": "newData.hasChildren(['nr', 'titel'])",
            "nr":         { ".validate": "newData.isNumber() && newData.val() > 0" },
            "tag":        { ".validate": "newData.isString() && newData.val().length <= 60" },
            "titel":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "erstelltAm": { ".validate": "newData.isNumber()" },
            "bescheidAm":       { ".validate": "newData.isNumber()" },
            "bescheidErreicht": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$sonst":     { ".validate": false }
          }
        },

        "karte": {
          "$ger": {
            ".validate": "newData.hasChildren(['name', 'preisCent'])",
            "nummer":       { ".validate": "newData.isString() && newData.val().length <= 10" },
            "name":         { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "beschreibung": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "kategorie":    { ".validate": "newData.isString() && newData.val().length <= 40" },
            "preisCent":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "sort":         { ".validate": "newData.isNumber()" }
          }
        },

        "bestellungen": {
          "$oid": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'neu' && !newData.child('rundeId').exists()) || (data.exists() && data.child('uid').val() === auth.uid && data.child('status').val() === 'neu' && !data.child('rundeId').exists() && (!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('status').val() === 'neu' && !newData.child('rundeId').exists() && newData.child('orga').val() === data.child('orga').val() && newData.child('erstelltAm').val() === data.child('erstelltAm').val()))))",
            ".validate": "newData.hasChildren(['name', 'positionen'])",
            "name":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "notiz":  { ".validate": "newData.isString() && newData.val().length <= 200" },
            "uid":    { ".validate": "newData.isString()" },
            "status": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "orga":   { ".validate": "newData.isBoolean()" },
            "rundeId": { ".validate": "newData.isString() && newData.val().length <= 60" },

            "positionen": {
              "$pos": {
                ".validate": "newData.hasChildren(['name', 'anzahl', 'preisCent'])",
                "gerichtId":    { ".validate": "newData.isString()" },
                "nummer":       { ".validate": "newData.isString() && newData.val().length <= 10" },
                "name":         { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
                "sonderwunsch": { ".validate": "newData.isString() && newData.val().length <= 120" },
                "anzahl":       { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9" },
                "preisCent":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
                "sort":         { ".validate": "newData.isNumber()" }
              }
            }
          }
        }
      }
    },

    "essenOrga": {
      "$pid": {
        ".read": "auth != null && (root.child('essen/' + $pid + '/meta/hostId').val() === auth.uid || (root.child('essenGeheim/' + 'essen-' + $pid + '/adminPinHash').exists() && root.child('essenPinProbe/' + 'essen-' + $pid + '/' + auth.uid).val() === root.child('essenGeheim/' + 'essen-' + $pid + '/adminPinHash').val()))",
        ".write": "auth != null && (root.child('essen/' + $pid + '/meta/hostId').val() === auth.uid || (root.child('essenGeheim/' + 'essen-' + $pid + '/adminPinHash').exists() && root.child('essenPinProbe/' + 'essen-' + $pid + '/' + auth.uid).val() === root.child('essenGeheim/' + 'essen-' + $pid + '/adminPinHash').val()))",
        "lieferantEmail":   { ".validate": "newData.isString() && newData.val().length <= 120" },
        "bestellerTelefon": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "$sonst": { ".validate": false }
      }
    }
  }
}
